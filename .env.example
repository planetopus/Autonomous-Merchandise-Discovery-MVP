# Copy to .env for local development. Never commit real credentials.
OPENAI_API_KEY=
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image
XAI_IMAGE_PRICE=0.02
XAI_IMAGE_EDIT_PRICE=0.022
ARTWORK_STORAGE_DIR=.artifacts
# gpt-4o-mini rejects web_search filters. Use gpt-5 or a newer reasoning model.
OPENAI_REASONING_MODEL=gpt-5
# Reasoning effort for GPT-5/GPT-6/o-series models; ignored for non-reasoning models.
OPENAI_REASONING_EFFORT=medium
# Maximum time allowed for one structured reasoning request, in seconds.
OPENAI_REASONING_TIMEOUT_SECONDS=420
# Vision detail for Luna artwork review: high is recommended for merchandise text.
OPENAI_IMAGE_DETAIL=high
# Optional price overrides. Defaults are selected from OPENAI_REASONING_MODEL.
# OPENAI_INPUT_PRICE_PER_MILLION=
# OPENAI_OUTPUT_PRICE_PER_MILLION=
OPENAI_WEB_SEARCH_PRICE_PER_CALL=0.01
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=merchandise_discovery
MVP_MAX_STAGE_ATTEMPTS=3
# The current client demo intentionally stops after Stage 1.
MVP_STOP_AFTER_STAGE=1
# Keep fixture mode while developing. Set to live only when you intend to spend API credits.
MVP_PROVIDER_MODE=fixture
# Optional. Stage 11 counts existing Etsy sticker listings when this is set.
# Live mode without it uses a public web result count. Fixture mode skips the check.
ETSY_API_KEY=
# Optional Reddit app credentials. When both the id and secret are set, live comment
# collection uses oauth.reddit.com. Otherwise it uses the public JSON endpoints.
# Create a script app at https://www.reddit.com/prefs/apps and use a descriptive User-Agent.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
# Optional override for the humor-reference CSV. When blank, each run fetches
# data/humor_references.csv from the raw GitHub URL of this repo's main branch
# (5 second timeout) and uses the committed file if that fetch fails.
HUMOR_REFERENCE_CSV_URL=
